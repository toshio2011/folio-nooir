+SDCardManager::ReadStatus SDCardManager::readFileChecked(const char* path, String& content,
+                                                         const size_t maxBytes) {
+  content = "";
+  if (!initialized) return ReadStatus::Unavailable;
+  if (!path || !path[0]) return ReadStatus::IoError;
+
+  FsFile file;
+  if (openFileForRead("SD", path, file)) {
+    const uint64_t expected = file.fileSize();
+    if (expected > maxBytes) {
+      file.close();
+      return ReadStatus::TooLarge;
+    }
+    if (!content.reserve(static_cast<unsigned int>(expected))) {
+      file.close();
+      return ReadStatus::IoError;
+    }
+
+    uint8_t buffer[256];
+    uint64_t total = 0;
+    while (total < expected) {
+      const size_t wanted = static_cast<size_t>(std::min<uint64_t>(sizeof(buffer), expected - total));
+      const int count = file.read(buffer, wanted);
+      if (count <= 0 || static_cast<size_t>(count) > wanted ||
+          !content.concat(reinterpret_cast<const char*>(buffer), static_cast<unsigned int>(count))) {
+        file.close();
+        content = "";
+        return ReadStatus::IoError;
+      }
+      total += static_cast<size_t>(count);
+    }
+    const bool readError = file.getError() != 0 || total != expected || file.fileSize() != expected;
+    file.close();
+    return readError ? ReadStatus::IoError : ReadStatus::Success;
+  }
+
+  // An open failure alone cannot distinguish a missing file from a failed
+  // sector read. Confirm absence by scanning its small parent directory and,
+  // when the settings directory itself is absent, the root entry. Any failed
+  // directory read is conservatively reported as I/O trouble.
+  const char* finalSlash = strrchr(path, '/');
+  const char* baseName = finalSlash ? finalSlash + 1 : path;
+  if (!baseName[0]) return ReadStatus::IoError;
+  String parentPath = finalSlash ? String(path).substring(0, finalSlash - path) : String(".");
+  if (parentPath.isEmpty()) parentPath = "/";
+
+  auto scanDirectory = [](const char* directoryPath, const char* wantedName, bool& complete) {
+    complete = false;
+    FsFile directory = SDCardManager::getInstance().vol().open(directoryPath, O_RDONLY);
+    if (!directory || !directory.isDirectory()) return false;
+    bool found = false;
+    char name[256];
+    while (true) {
+      FsFile entry = directory.openNextFile();
+      if (!entry) break;
+      name[0] = '\0';
+      entry.getName(name, sizeof(name));
+      entry.close();
+      if (strcmp(name, wantedName) == 0) {
+        found = true;
+        break;
+      }
+    }
+    complete = found || directory.getError() == 0;
+    directory.close();
+    return found;
+  };
+
+  bool parentScanComplete = false;
+  if (scanDirectory(parentPath.c_str(), baseName, parentScanComplete)) return ReadStatus::IoError;
+  if (parentScanComplete) return ReadStatus::NotFound;
+
+  // The settings directory does not exist on a fresh install. Check its one
+  // parent so a missing directory is not mistaken for a transient card error.
+  if (parentPath == "/.crosspoint") {
+    bool rootScanComplete = false;
+    if (scanDirectory("/", ".crosspoint", rootScanComplete)) return ReadStatus::IoError;
+    if (rootScanComplete) return ReadStatus::ParentMissing;
+  }
+  return ReadStatus::IoError;
+}
