+struct GapConnectionState {
+  uint16_t handles[NIMBLE_MAX_CONNECTIONS] = {};
+  uint8_t count = 0;
+};
+
+int inspectGapConnection(uint16_t connHandle, void* arg) {
+  auto* state = static_cast<GapConnectionState*>(arg);
+  if (!state) return 0;
+  if (state->count < NIMBLE_MAX_CONNECTIONS) state->handles[state->count++] = connHandle;
+  return 0;
+}
+
+uint8_t gapConnectionCount(bool closeAll = false) {
+  if (!NimBLEDevice::isInitialized()) return 0;
+  GapConnectionState state;
+  ble_gap_conn_foreach_handle(inspectGapConnection, &state);
+  if (closeAll) {
+    for (uint8_t i = 0; i < state.count; ++i) {
+      const uint16_t handle = state.handles[i];
+      if (ble_gap_conn_find(handle, nullptr) != 0) continue;
+      NimBLEClient* client = NimBLEDevice::getClientByHandle(handle);
+      if (client) {
+        client->disconnect();
+      } else {
+        // NimBLE can retain a controller link after its C++ client has gone stale.
+        // Terminate that GAP link directly so it cannot poison the next init cycle.
+        ble_gap_terminate(handle, BLE_ERR_REM_USER_CONN_TERM);
+      }
+    }
+  }
+  return state.count;
+}
+
+bool clientMatchesHostState(NimBLEClient* client) {
+  if (!client || !NimBLEDevice::isInitialized()) return false;
+  const NimBLEAddress peer = client->getPeerAddress();
+  if (NimBLEDevice::getClientByPeerAddress(peer) != client) return false;
+  const bool hasGapLink = ble_gap_conn_find(client->getConnHandle(), nullptr) == 0;
+  return client->isConnected() == hasGapLink;
+}
+
+bool closeAllGapConnections(uint32_t timeoutMs) {
+  const uint32_t startedAt = millis();
+  while (gapConnectionCount(true) != 0 && millis() - startedAt < timeoutMs) {
+    vTaskDelay(pdMS_TO_TICKS(20));
+  }
+  return gapConnectionCount() == 0;
+}
